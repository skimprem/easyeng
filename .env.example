# Скопируйте в .env и заполните. Сгенерировать ключ:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Адрес сайта, если открываете не с localhost (через запятую):
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 — если сайт работает за HTTPS
DJANGO_SECURE_COOKIES=0
EASYENG_PORT=8000
# Необязательно:
MYMEMORY_EMAIL=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_KEY=
